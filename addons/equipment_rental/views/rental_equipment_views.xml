<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORMULARIO -->
    <record id="view_rental_equipment_form" model="ir.ui.view">
        <field name="name">rental.equipment.form</field>
        <field name="model">rental.equipment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_maintenance" type="object"
                            string="Enviar a mantenimiento" class="btn-secondary"
                            invisible="status == 'maintenance'"/>
                    <button name="action_set_available" type="object"
                            string="Marcar disponible" class="btn-primary"
                            invisible="status == 'available'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej. Taladro percutor"/></h1>
                        <field name="reference" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="daily_price"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="rental_count"/>
                            <field name="total_revenue"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- LISTA -->
    <record id="view_rental_equipment_list" model="ir.ui.view">
        <field name="name">rental.equipment.list</field>
        <field name="model">rental.equipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="name"/>
                <field name="category"/>
                <field name="daily_price"/>
                <field name="rental_count"/>
                <field name="total_revenue" sum="Total"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-warning="status == 'maintenance'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- KANBAN -->
    <record id="view_rental_equipment_kanban" model="ir.ui.view">
        <field name="name">rental.equipment.kanban</field>
        <field name="model">rental.equipment</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image me-2">
                            <field name="image" widget="image" class="o_image_64_contain" alt="Equipo"/>
                        </div>
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div class="text-muted">
                                <field name="reference"/>
                            </div>
                            <div>
                                <field name="daily_price"/> / día
                            </div>
                            <div>
                                <field name="status" widget="label_selection"
                                       options="{'classes': {'available': 'success', 'maintenance': 'warning'}}"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- BÚSQUEDA -->
    <record id="view_rental_equipment_search" model="ir.ui.view">
        <field name="name">rental.equipment.search</field>
        <field name="model">rental.equipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="category"/>
                <filter name="filter_available" string="Disponibles"
                        domain="[('status', '=', 'available')]"/>
                <filter name="filter_maintenance" string="En mantenimiento"
                        domain="[('status', '=', 'maintenance')]"/>
                <group>
                    <filter name="group_category" string="Categoría"
                            context="{'group_by': 'category'}"/>
                    <filter name="group_status" string="Estado"
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="action_rental_equipment" model="ir.actions.act_window">
        <field name="name">Equipos</field>
        <field name="res_model">rental.equipment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_rental_equipment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer equipo alquilable
            </p>
            <p>Registra herramientas, maquinaria o equipos con su tarifa diaria.</p>
        </field>
    </record>

</odoo>
