<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_rental_order" model="ir.sequence">
        <field name="name">Orden de Alquiler</field>
        <field name="code">rental.order</field>
        <field name="prefix">ALQ/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_rental_equipment" model="ir.sequence">
        <field name="name">Equipo Alquilable</field>
        <field name="code">rental.equipment</field>
        <field name="prefix">EQ/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
